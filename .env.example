# Copia in .env e inserisci l'URL del database PostgreSQL.
# Per Vercel: aggiungi il database da Dashboard → Storage → Postgres, DATABASE_URL viene impostato automaticamente.
# Per sviluppo locale: usa lo stesso URL (Vercel Postgres) oppure un DB gratuito su https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
