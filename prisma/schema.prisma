generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                 String   @id @default(cuid())
  name               String
  isGoalkeeper       Boolean  @default(false)
  age                Int?     // età in anni
  practicesSport     Boolean? // pratica qualche sport
  sportTimesPerWeek  Int?     // quante volte a settimana (0-7+)
  hasPlayedFootball  Boolean? // ha già giocato a calcio
  footballYearsAgo   Int?     // quanto tempo fa (anni)
  createdAt          DateTime @default(now())
  matches            MatchPlayer[]
}

model Match {
  id        String   @id @default(cuid())
  date      DateTime
  concluded Boolean  @default(false)
  createdAt DateTime @default(now())
  players   MatchPlayer[]
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  team     Int    // 1 o 2
  isGoalkeeper Boolean
  goals    Int    @default(0)
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}
