generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                     String   @id @default(cuid())
  name                   String
  isGoalkeeper           Boolean  @default(false)
  age                    Int?     // età in anni
  practicesSport         Boolean? // pratica qualche sport
  sportTimesPerWeek      Int?     // quante volte a settimana (0-7+)
  hasPlayedFootball       Boolean? // ha già giocato a calcio
  footballYearsAgo       Int?     // quanto tempo fa (anni)
  createdAt              DateTime @default(now())
  matches                MatchPlayer[]
  tournamentTeamPlayers  TournamentTeamPlayer[]
  tournamentMatchPlayers TournamentMatchPlayer[]
  tournamentRatings      TournamentRating[]
}

model Match {
  id        String   @id @default(cuid())
  date      DateTime
  concluded Boolean  @default(false)
  createdAt DateTime @default(now())
  players   MatchPlayer[]
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  team     Int    // 1 o 2
  isGoalkeeper Boolean
  goals    Int    @default(0)
  rating   Int?   // pagella: 1-10
  note     String? // pagella: nota italiana
  noteEn   String? // pagella: nota inglese (inserita manualmente)
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Tournament {
  id        String   @id @default(cuid())
  name      String?
  date      DateTime?
  time      String?  // es. "18:00"
  location  String?
  format    String   @default("round_robin")
  numTeams  Int
  status    String   @default("draft")
  createdAt DateTime @default(now())
  teams     TournamentTeam[]
  matches   TournamentMatch[]
  ratings   TournamentRating[]
}

model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  teamNumber   Int
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players      TournamentTeamPlayer[]
  matchesAs1   TournamentMatch[] @relation("Team1")
  matchesAs2   TournamentMatch[] @relation("Team2")
}

model TournamentTeamPlayer {
  id       String   @id @default(cuid())
  teamId   String
  playerId String
  team     TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([teamId, playerId])
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  team1Id      String
  team2Id      String
  goals1       Int      @default(0)
  goals2       Int      @default(0)
  date         DateTime?
  status       String   @default("scheduled")
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team1        TournamentTeam @relation("Team1", fields: [team1Id], references: [id], onDelete: Cascade)
  team2        TournamentTeam @relation("Team2", fields: [team2Id], references: [id], onDelete: Cascade)
  players      TournamentMatchPlayer[]
}

model TournamentMatchPlayer {
  id       String   @id @default(cuid())
  matchId  String
  playerId String
  team     Int
  goals    Int      @default(0)
  match    TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([matchId, playerId])
}

model TournamentRating {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  rating       Int?
  note         String?
  noteEn       String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, playerId])
}
